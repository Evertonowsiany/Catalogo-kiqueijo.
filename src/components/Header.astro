---
import type { Category } from '../types';
interface Props {
  categories: Category[];
}
const { categories } = Astro.props;
---

<header class="site-header">
  <nav class="navbar" id="navbar">
    <a href="#" class="navbar-brand">
      <div class="navbar-logo">🧀</div>
      <div>
        <div class="navbar-title">Kiqueijo</div>
        <div class="navbar-subtitle">Insumos para Food Service</div>
      </div>
    </a>

    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Abrir menu">☰</button>
    <ul class="navbar-links" id="navLinks">
      <li><a href="#" class="active">Home</a></li>
      <li><a href="#produtos">Produtos e Insumos</a></li>
      <li><a href="#categorias">Categorias</a></li>
      <li><a href="#footer">Contato</a></li>
    </ul>
  </nav>

  <!-- Announcement Bar -->
  <div class="announcement-bar">
    <span class="announcement-bar-dot"></span>
    Pedidos feitos até 10h serão entregues no mesmo dia!
  </div>
</header>
